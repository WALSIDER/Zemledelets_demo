PORT=3000

# Optional secret for POST /api/news/sync
NEWS_SYNC_TOKEN=
NEWS_SYNC_LIMIT=12
NEWS_STARTUP_LIMIT=48
NEWS_SYNC_INTERVAL_MINUTES=30
NEWS_SYNC_ON_STARTUP=true

# Local Ollama for translation, auto-tagging, summary generation and read time
OLLAMA_MODEL=llama3.2
OLLAMA_API_BASE=http://127.0.0.1:11434/v1
NEWS_OUTPUT_LANGUAGE=ru
